{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PasswordReset": {
    "TokenTTLMinutes": 30,
    "DefaultRedirectUrl": "https://localhost:5173/reset-password",
    "AllowedRedirectHosts": [
      "localhost",
      "127.0.0.1",
      "your-frontend.example",
      "your-mobile.example"
    ]
  },
  "Email": {
    "Provider": "Smtp",
    "From": "yourgmail@gmail.com",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "Username": "yourgmail@gmail.com",
    "Password": ""
  }
}
